DJANGO_SECRET_KEY=replace-this-value
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Development may use the default project media directory.
# Production must set an explicit persistent path outside static roots.
# DJANGO_MEDIA_ROOT=C:\path\outside\the\release\media
ACCOUNT_ACTIVATION_TIMEOUT=86400
ACCOUNT_ACTIVATION_MAX_ATTEMPTS=5
PASSWORD_RESET_TIMEOUT=3600
MFA_ENCRYPTION_KEY=replace-with-a-long-random-secret
MFA_RECOVERY_CODE_COUNT=10
MFA_ENFORCE_OWNER=True
MFA_REQUIRE_INTERNAL_USERS=False
MFA_FAILURE_LIMIT=5
MFA_FAILURE_TIMEOUT_MINUTES=15
DJANGO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
DJANGO_CACHE_LOCATION=get-nailed-development
LOGIN_FAILURE_LIMIT=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_CAPTCHA_THRESHOLD=3
DJANGO_SESSION_ENGINE=django.contrib.sessions.backends.db
OWNER_INACTIVITY_TIMEOUT_MINUTES=30
STAFF_INACTIVITY_TIMEOUT_MINUTES=60
SENSITIVE_ACTION_REAUTHENTICATION_MINUTES=5
BOOKING_UNVERIFIED_TIMEOUT_MINUTES=30
BOOKING_VERIFICATION_CODE_TIMEOUT_MINUTES=15
BOOKING_VERIFICATION_MAX_ATTEMPTS=5
BOOKING_RESEND_COOLDOWN_MINUTES=5
BOOKING_MAX_RESENDS=3
BOOKING_ACCESS_TOKEN_TIMEOUT_HOURS=72
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
PASSWORD_RESET_EMAIL_LIMIT=3
PASSWORD_RESET_EMAIL_WINDOW_MINUTES=15
SECURITY_EMAIL_LIMIT=5
SECURITY_EMAIL_WINDOW_MINUTES=60
MAX_IMAGE_UPLOAD_SIZE_MB=5
MAX_IMAGE_UPLOAD_PIXELS=20000000
DATA_UPLOAD_MAX_NUMBER_FILES=5
# Production profile
# DJANGO_ENV=production
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=app.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# PUBLIC_BASE_URL=https://app.example.com
# DJANGO_MEDIA_ROOT=/srv/get-nailed/media
# DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
# DJANGO_CACHE_LOCATION=redis://127.0.0.1:6379/1
# Production transport security defaults to enabled when DJANGO_ENV=production
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SESSION_COOKIE_SAMESITE=Lax
# Enable HSTS only after HTTPS is confirmed on every required hostname
# ENABLE_HSTS=True
# SECURE_HSTS_SECONDS=31536000
# Production SMTP example
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
# PostgreSQL example
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=get_nailed
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432
